class Solution:
    def processStr(self, s):
        res = []

        for ch in s:
            if ch.islower():
                res.append(ch)

            elif ch == '*':
                if res:
                    res.pop()

            elif ch == '#':
                res.extend(res)

            else:  # ch == '%'
                res.reverse()

        return ''.join(res)
        

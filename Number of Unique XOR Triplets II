class Solution:
    def uniqueXorTriplets(self, nums: list[int]) -> int:
        # Step 1: Find unique pair XORs
        pair_xors = set()
        n = len(nums)
        for i in range(n):
            for j in range(i, n):
                pair_xors.add(nums[i] ^ nums[j])
        
        # Step 2: Combine pair XORs with unique numbers in nums
        unique_nums = list(set(nums))
        triplet_xors = set()
        for p in pair_xors:
            for x in unique_nums:
                triplet_xors.add(p ^ x)
                
        return len(triplet_xors)

class Solution:
    def zigZagArrays(self, n, l, r):
        MOD = 10**9 + 7

        m = r - l + 1

        if n == 1:
            return m

        up = [0] * (m + 1)
        down = [0] * (m + 1)

        for x in range(1, m + 1):
            up[x] = x - 1
            down[x] = m - x

        if n == 2:
            return (sum(up) + sum(down)) % MOD

        for _ in range(3, n + 1):
            new_up = [0] * (m + 1)
            new_down = [0] * (m + 1)

            pref = [0] * (m + 1)
            for i in range(1, m + 1):
                pref[i] = (pref[i - 1] + down[i]) % MOD

            for x in range(1, m + 1):
                new_up[x] = pref[x - 1]

            suff = [0] * (m + 2)
            for i in range(m, 0, -1):
                suff[i] = (suff[i + 1] + up[i]) % MOD

            for x in range(1, m + 1):
                new_down[x] = suff[x + 1]

            up = new_up
            down = new_down

        return (sum(up) + sum(down)) % MOD

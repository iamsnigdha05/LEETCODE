#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    int concatenatedBinary(int n) {
        const int MOD = 1e9 + 7;
        long long res = 0;
        int bitLength = 0;
        
        for (int i = 1; i <= n; i++) {
            // If i is power of 2, increase bit length
            if ((i & (i - 1)) == 0) {
                bitLength++;
            }
            
            res = ((res << bitLength) % MOD + i) % MOD;
        }
        
        return (int)res;
    }
};

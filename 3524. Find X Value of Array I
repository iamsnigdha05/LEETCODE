class Solution:
    def resultArray(self, nums, k):
        answer = [0] * k
        dp = [0] * k

        for num in nums:
            remainder = num % k
            new_dp = [0] * k

            # Start a new subarray with this number
            new_dp[remainder] += 1

            # Extend previous subarrays
            for r in range(k):
                if dp[r] > 0:
                    new_remainder = (r * remainder) % k
                    new_dp[new_remainder] += dp[r]

            # Add all subarrays ending here to the answer
            for r in range(k):
                answer[r] += new_dp[r]

            dp = new_dp

        return answer

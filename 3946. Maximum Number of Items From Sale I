class Solution:
    def maximumSaleItems(self, items: list[list[int]], budget: int) -> int:
        MAX_F = 1500
        freq = [0] * (MAX_F + 1)
        min_price = float('inf')
        
        for f, p in items:
            freq[f] += 1
            if p < min_price:
                min_price = p
                
        # mult_count[f] = total items whose factor is a multiple of f
        mult_count = [0] * (MAX_F + 1)
        for f in range(1, MAX_F + 1):
            if freq[f] > 0:
                for m in range(f, MAX_F + 1, f):
                    mult_count[f] += freq[m]
                    
        # 0/1 Knapsack for buying at most 1 copy of each item
        # dp[c] = max items obtained with exact cost c
        dp = [-1] * (budget + 1)
        dp[0] = 0
        
        for f, p in items:
            if p > budget:
                continue
            # Value of buying the 1st copy of this item: 1 + free copies
            val = 1 + (mult_count[f] - 1)
            for c in range(budget, p - 1, -1):
                if dp[c - p] != -1:
                    if dp[c - p] + val > dp[c]:
                        dp[c] = dp[c - p] + val
                        
        # Combine knapsack states with greedy spending of remaining budget on cheapest item
        ans = 0
        for c in range(budget + 1):
            if dp[c] != -1:
                extra = (budget - c) // min_price
                ans = max(ans, dp[c] + extra)
                
        return ans

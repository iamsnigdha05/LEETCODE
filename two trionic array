class Solution(object):
    def maxSumTrionic(self, nums):
        n = len(nums)
        if n < 4: return -1
        
         
        inc = [float('-inf')] * n
         
        valley = [float('-inf')] * n
        
        trionic = [float('-inf')] * n
        
        for i in range(1, n):
            
            if nums[i] > nums[i-1]:
                 
                inc[i] = nums[i] + max(nums[i-1], inc[i-1])
            if valley[i-1] != float('-inf') or trionic[i-1] != float('-inf'):
                    trionic[i] = nums[i] + max(valley[i-1], trionic[i-1])
            
            elif nums[i] < nums[i-1]:
               
                if inc[i-1] != float('-inf') or valley[i-1] != float('-inf'):
                    valley[i] = nums[i] + max(inc[i-1], valley[i-1])
                    
        ans = max(trionic)
        return int(ans) if ans != float('-inf') else -1
        

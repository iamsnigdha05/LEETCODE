class Solution:
    def distinctSubseqII(self, s):
        MOD = 10**9 + 7

        # dp[c] = number of distinct subsequences
        # ending with character c
        dp = [0] * 26

        for ch in s:
            i = ord(ch) - ord('a')

            # All previous distinct subsequences can be
            # extended by ch, plus ch itself.
            dp[i] = (sum(dp) + 1) % MOD

        return sum(dp) % MOD

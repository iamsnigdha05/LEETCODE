class Solution:
    def removeOuterParentheses(self, s):
        answer = []
        depth = 0

        for ch in s:
            if ch == '(':
                if depth > 0:
                    answer.append(ch)
                depth += 1

            else:
                depth -= 1
                if depth > 0:
                    answer.append(ch)

        return ''.join(answer)

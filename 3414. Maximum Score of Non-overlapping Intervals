from bisect import bisect_left

class Solution:
    def maximumWeight(self, intervals: list[list[int]]) -> list[int]:
        n = len(intervals)
        # Store (l, r, weight, original_index)
        arr = sorted([(l, r, w, i) for i, (l, r, w) in enumerate(intervals)], key=lambda x: (x[1], x[0], x[3]))
        
        # Extracts just end times for binary search
        ends = [x[1] for x in arr]
        
        # dp[i][k] = (score, sorted_list_of_original_indices)
        # using first i intervals with at most k selected
        dp = [[(0, []) for _ in range(5)] for _ in range(n + 1)]
        
        for i in range(1, n + 1):
            l, r, w, idx = arr[i - 1]
            
            # Find last interval with end < l (strictly non-overlapping)
            p = bisect_left(ends, l) - 1
            p_idx = p + 1  # 1-based DP index
            
            for k in range(1, 5):
                # Option 1: Skip interval i-1
                best_score, best_indices = dp[i - 1][k]
                
                # Option 2: Take interval i-1
                prev_score, prev_indices = dp[p_idx][k - 1]
                cand_score = prev_score + w
                cand_indices = sorted(prev_indices + [idx])
                
                # Choose maximum score or lexicographically smaller indices on tie
                if cand_score > best_score:
                    best_score = cand_score
                    best_indices = cand_indices
                elif cand_score == best_score:
                    if not best_indices or cand_indices < best_indices:
                        best_indices = cand_indices
                        
                dp[i][k] = (best_score, best_indices)
                
        return dp[n][4][1]

class Solution(object):
    def minBitwiseArray(self, nums):
        ans = []
        for p in nums:
            if p == 2:
                ans.append(-1)
                continue

            
            t = 0
            temp = p
            while temp & 1:
                t += 1
                temp >>= 1

            ans.append(p - (1 << (t - 1)))
        return ans



        

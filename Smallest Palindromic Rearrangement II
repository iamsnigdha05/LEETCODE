import collections

class Solution:
    def smallestPalindrome(self, s, k):
        count = collections.Counter(s)
        
        # Extract the half-frequencies and center character
        half_count = [0] * 26
        mid_letter = ""
        for c, freq in count.items():
            half_count[ord(c) - ord('a')] = freq // 2
            if freq % 2 == 1:
                mid_letter = c
                
        MAX_K = 10**6 + 1
        
        # Helper: nCr capped at MAX_K to prevent large integer arithmetic
        def nCr(n, r):
            if r < 0 or r > n:
                return 0
            if r == 0 or r == n:
                return 1
            if r > n - r:
                r = n - r
            res = 1
            for i in range(1, r + 1):
                res = res * (n - i + 1) // i
                if res >= MAX_K:
                    return MAX_K
            return res

        # Helper: Fast O(26) permutation count using nCr
        def count_arrangements(counts):
            total = sum(counts)
            res = 1
            for freq in counts:
                if freq > 0:
                    res *= nCr(total, freq)
                    if res >= MAX_K:
                        return MAX_K
                    total -= freq
            return res

        # Step 1: Check total possible permutations
        total_perms = count_arrangements(half_count)
        if k > total_perms:
            return ""

        # Step 2: Build the left half character-by-character
        half_len = sum(half_count)
        left = []

        for _ in range(half_len):
            for i in range(26):
                if half_count[i] == 0:
                    continue
                
                # Try placing letter 'a' + i
                half_count[i] -= 1
                arrangements = count_arrangements(half_count)
                
                if arrangements >= k:
                    left.append(chr(ord('a') + i))
                    break  # Found character for this slot
                else:
                    k -= arrangements
                    half_count[i] += 1  # Backtrack and try next character
                    
        left_str = "".join(left)
        return left_str + mid_letter + left_str[::-1]

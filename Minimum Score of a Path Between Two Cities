from collections import defaultdict, deque

class Solution:
    def minScore(self, n, roads):
        graph = defaultdict(list)

        for u, v, d in roads:
            graph[u].append((v, d))
            graph[v].append((u, d))

        q = deque([1])
        visited = {1}
        ans = float('inf')

        while q:
            u = q.popleft()

            for v, d in graph[u]:
                ans = min(ans, d)
                if v not in visited:
                    visited.add(v)
                    q.append(v)

        return ans

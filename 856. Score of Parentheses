class Solution:
    def scoreOfParentheses(self, s):
        stack = [0]

        for ch in s:
            if ch == '(':
                # Start a new nested level
                stack.append(0)
            else:
                score = stack.pop()

                if score == 0:
                    score = 1
                else:
                    score = 2 * score

                stack[-1] += score

        return stack[0]

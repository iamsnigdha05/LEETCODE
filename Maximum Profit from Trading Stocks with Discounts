import collections

class Solution:
    def maxProfit(self, n, present, future, hierarchy, budget):
        
        UNREACHABLE = float('-inf') 
        
         
        adj = collections.defaultdict(list)
        for u, v in hierarchy:
            adj[u].append(v)

        
        DP_skip = {i: [UNREACHABLE] * (budget + 1) for i in range(1, n + 1)}
        DP_buy = {i: [UNREACHABLE] * (budget + 1) for i in range(1, n + 1)}

        for i in range(1, n + 1):
            DP_skip[i][0] = 0
            DP_buy[i][0] = 0

        present_0_indexed = [0] + present
        future_0_indexed = [0] + future

        def dfs(u):
            
            for v in adj[u]:
                dfs(v)
            
             
            temp_skip = [UNREACHABLE] * (budget + 1)  
            temp_buy = [UNREACHABLE] * (budget + 1)  
            temp_skip[0] = 0
            temp_buy[0] = 0

            for v in adj[u]:
                new_temp_skip = [UNREACHABLE] * (budget + 1)
                new_temp_buy = [UNREACHABLE] * (budget + 1)
                
                 
                for b_u in range(budget + 1):
                    if temp_skip[b_u] == UNREACHABLE: continue
                    for b_v in range(budget + 1):
                        if b_u + b_v <= budget and DP_skip[v][b_v] != UNREACHABLE:
                            new_b = b_u + b_v
                            profit = temp_skip[b_u] + DP_skip[v][b_v]
                            new_temp_skip[new_b] = max(new_temp_skip[new_b], profit)
                temp_skip = new_temp_skip 

                 
                for b_u in range(budget + 1):
                    if temp_buy[b_u] == UNREACHABLE: continue
                    for b_v in range(budget + 1):
                        if b_u + b_v <= budget and DP_buy[v][b_v] != UNREACHABLE:
                            new_b = b_u + b_v
                            profit = temp_buy[b_u] + DP_buy[v][b_v]
                            new_temp_buy[new_b] = max(new_temp_buy[new_b], profit)
                temp_buy = new_temp_buy 

           
            P_u = present_0_indexed[u]           
            C_u = future_0_indexed[u] - P_u      
            P_u_disc = P_u // 2                  
            C_u_disc = future_0_indexed[u] - P_u_disc  
            
             
            for b in range(budget + 1):
               
                DP_skip[u][b] = max(DP_skip[u][b], temp_skip[b])

               
                if b >= P_u and temp_buy[b - P_u] != UNREACHABLE:  
                    profit = C_u + temp_buy[b - P_u]
                    DP_skip[u][b] = max(DP_skip[u][b], profit)

            
            for b in range(budget + 1):
                
                DP_buy[u][b] = max(DP_buy[u][b], temp_skip[b]) 

                 
                if b >= P_u_disc and temp_buy[b - P_u_disc] != UNREACHABLE: 
                    profit = C_u_disc + temp_buy[b - P_u_disc]
                    DP_buy[u][b] = max(DP_buy[u][b], profit)

        
        dfs(1)

         
        return max(0, int(max(DP_skip[1])))

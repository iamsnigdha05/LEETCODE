class Solution:
    def lexicographicallySmallestArray(self, nums, limit):
        n = len(nums)

        # (value, original_index)
        arr = sorted((value, i) for i, value in enumerate(nums))

        answer = [0] * n
        i = 0

        while i < n:
            j = i + 1

            # Find one connected group
            while j < n and arr[j][0] - arr[j - 1][0] <= limit:
                j += 1

            # Original indices of this group
            indices = sorted(index for _, index in arr[i:j])

            # Smallest values assigned to smallest original indices
            for index, (value, _) in zip(indices, arr[i:j]):
                answer[index] = value

            i = j

        return answer

class Solution:
    def zigZagArrays(self, n, l, r):
        MOD = 10**9 + 7
        M = r - l + 1
        SIZE = 2 * M
        
         
        T = [[0] * SIZE for _ in range(SIZE)]
        
        for v in range(M):
            
            for vp in range(v + 1, M):
                T[M + vp][v] = 1
                
          
            for vp in range(v):
                T[vp][M + v] = 1
                
         
        V = [0] * SIZE
        for v in range(M):
            V[v] = M - 1 - v   
            V[M + v] = v      
            
        
        def mat_mul(A, B):
            C = [[0] * SIZE for _ in range(SIZE)]
            for i in range(SIZE):
                for k in range(SIZE):
                    if A[i][k] == 0:
                        continue
                    for j in range(SIZE):
                        C[i][j] = (C[i][j] + A[i][k] * B[k][j]) % MOD
            return C

        def mat_vec_mul(A, vec):
            res = [0] * SIZE
            for i in range(SIZE):
                s = 0
                for j in range(SIZE):
                    s = (s + A[i][j] * vec[j]) % MOD
                res[i] = s
            return res

         
        power = n - 2
        ans_mat = [[1 if i == j else 0 for j in range(SIZE)] for i in range(SIZE)]
        base = T
        
        while power > 0:
            if power & 1:
                ans_mat = mat_mul(ans_mat, base)
            base = mat_mul(base, base)
            power >>= 1
            
         
        final_vector = mat_vec_mul(ans_mat, V)
        
         
        return sum(final_vector) % MOD

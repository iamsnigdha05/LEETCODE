from bisect import bisect_right

class Solution:
    def pathExistenceQueries(self, n, nums, maxDiff, queries):
        order = sorted(range(n), key=lambda x: nums[x])
        vals = [nums[i] for i in order]

        pos = [0] * n
        for i, idx in enumerate(order):
            pos[idx] = i

        # farthest node reachable in one edge to the right
        nxt = [0] * n
        for i in range(n):
            nxt[i] = bisect_right(vals, vals[i] + maxDiff) - 1

        LOG = (n + 1).bit_length()
        up = [nxt[:]]

        for k in range(1, LOG):
            prev = up[-1]
            cur = [0] * n
            for i in range(n):
                cur[i] = prev[prev[i]]
            up.append(cur)

        ans = []

        for u, v in queries:
            l, r = pos[u], pos[v]
            if l > r:
                l, r = r, l

            # disconnected component
            reachable = l
            for k in range(LOG - 1, -1, -1):
                reachable = up[k][reachable]
            if reachable < r:
                ans.append(-1)
                continue

            jumps = 0
            cur = l

            for k in range(LOG - 1, -1, -1):
                if up[k][cur] < r:
                    cur = up[k][cur]
                    jumps += 1 << k

            if cur < r:
                jumps += 1

            ans.append(jumps)

        return ans
        

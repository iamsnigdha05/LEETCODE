class Solution:
    def sumAndMultiply(self, s, queries):
        MOD = 10**9 + 7
        n = len(s)

        # number of non-zero digits before position i
        nz_count = [0] * (n + 1)

        nz_digits = []
        prefix_sum = [0]

        for i, ch in enumerate(s):
            nz_count[i + 1] = nz_count[i]

            if ch != '0':
                d = int(ch)
                nz_digits.append(d)
                nz_count[i + 1] += 1
                prefix_sum.append(prefix_sum[-1] + d)

        m = len(nz_digits)

        pow10 = [1] * (m + 1)
        for i in range(1, m + 1):
            pow10[i] = (pow10[i - 1] * 10) % MOD

        # rolling hash of concatenated non-zero digits
        H = [0] * (m + 1)
        for i in range(m):
            H[i + 1] = (H[i] * 10 + nz_digits[i]) % MOD

        ans = []

        for l, r in queries:
            a = nz_count[l]
            b = nz_count[r + 1]

            # no non-zero digits
            if a == b:
                ans.append(0)
                continue

            x = (H[b] - H[a] * pow10[b - a]) % MOD
            digit_sum = prefix_sum[b] - prefix_sum[a]

            ans.append((x * digit_sum) % MOD)

        return ans

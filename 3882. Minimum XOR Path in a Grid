
class Solution:
    def minCost(self, grid):
        m, n = len(grid), len(grid[0])
        LIMIT = 1024

        dp = [[[False] * LIMIT for _ in range(n)] for _ in range(m)]
        dp[0][0][grid[0][0]] = True

        for i in range(m):
            for j in range(n):
                if i == 0 and j == 0:
                    continue

                value = grid[i][j]

                if i > 0:
                    for x in range(LIMIT):
                        if dp[i - 1][j][x]:
                            dp[i][j][x ^ value] = True

                if j > 0:
                    for x in range(LIMIT):
                        if dp[i][j - 1][x]:
                            dp[i][j][x ^ value] = True

        for x in range(LIMIT):
            if dp[m - 1][n - 1][x]:
                return x

        return 0

class Solution:
    def evaluate(self, s, knowledge):
        values = dict(knowledge)
        answer = []
        i = 0

        while i < len(s):
            if s[i] == '(':
                j = i + 1

                while s[j] != ')':
                    j += 1

                key = s[i + 1:j]

                if key in values:
                    answer.append(values[key])
                else:
                    answer.append("?")

                i = j + 1
            else:
                answer.append(s[i])
                i += 1

        return ''.join(answer)

class Solution:
    def maxActiveSectionsAfterTrade(self, s):
        ones = s.count('1')
        t = "1" + s + "1"
        n = len(t)

        runs = []
        i = 0
        while i < n:
            j = i
            while j < n and t[j] == t[i]:
                j += 1
            runs.append((t[i], j - i))
            i = j

        ans = ones

        
        for i in range(2, len(runs) - 2):
            if runs[i][0] != '1':
                continue

            left_zero = runs[i - 1][1]
            right_zero = runs[i + 1][1]

            ans = max(ans, ones + left_zero + right_zero)

        return ans
        

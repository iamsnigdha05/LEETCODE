class Solution:
    def maxSum(self, nums, k):
        MOD = 10**9 + 7
        bits = [0] * 30

        for num in nums:
            for b in range(30):
                if num & (1 << b):
                    bits[b] += 1

        answer = 0

        for _ in range(k):
            num = 0

            for b in range(30):
                if bits[b] > 0:
                    num |= 1 << b
                    bits[b] -= 1

            answer = (answer + num * num) % MOD

        return answer

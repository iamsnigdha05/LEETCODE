class Solution:
    def checkValidString(self, s):
        low = 0
        high = 0

        for ch in s:
            if ch == '(':
                low += 1
                high += 1

            elif ch == ')':
                low -= 1
                high -= 1

            else:  # '*'
                low -= 1
                high += 1

            # Minimum unmatched '(' cannot be negative
            low = max(low, 0)

            # Even the maximum possibility is invalid
            if high < 0:
                return False

        return low == 0

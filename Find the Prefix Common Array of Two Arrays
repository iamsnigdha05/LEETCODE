class Solution:
    def findThePrefixCommonArray(self, A, B):

        freq = {}
        common = 0
        ans = []

        for a, b in zip(A, B):

            freq[a] = freq.get(a, 0) + 1
            if freq[a] == 2:
                common += 1

            freq[b] = freq.get(b, 0) + 1
            if freq[b] == 2:
                common += 1

            ans.append(common)

        return ans

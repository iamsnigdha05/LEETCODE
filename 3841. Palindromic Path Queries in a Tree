
class Solution:
    def palindromePath(self, n, edges, s,
                       queries):

        graph = [[] for _ in range(n)]
        for u, v in edges:
            graph[u].append(v)
            graph[v].append(u)

        # Build Euler tour, parent, depth, and root-to-node XOR masks.
        parent = [0] * n
        depth = [0] * n
        tin = [0] * n
        tout = [0] * n
        root_mask = [0] * n
        euler = []
        timer = 0

        stack = [(0, 0, 0, 0)]  # node, parent, mask, exit flag

        while stack:
            u, p, mask, exiting = stack.pop()

            if exiting:
                tout[u] = timer - 1
                continue

            parent[u] = p
            root_mask[u] = mask ^ (1 << (ord(s[u]) - ord('a')))
            tin[u] = timer
            euler.append(u)
            timer += 1

            stack.append((u, p, mask, 1))

            for v in reversed(graph[u]):
                if v != p:
                    depth[v] = depth[u] + 1
                    stack.append((v, u, root_mask[u], 0))

        # Binary lifting for LCA.
        LOG = n.bit_length()
        up = [parent[:]]

        for j in range(1, LOG):
            prev = up[-1]
            up.append([prev[prev[i]] for i in range(n)])

        def lca(u, v):
            if depth[u] < depth[v]:
                u, v = v, u

            diff = depth[u] - depth[v]
            bit = 0

            while diff:
                if diff & 1:
                    u = up[bit][u]
                diff >>= 1
                bit += 1

            if u == v:
                return u

            for j in range(LOG - 1, -1, -1):
                if up[j][u] != up[j][v]:
                    u = up[j][u]
                    v = up[j][v]

            return parent[u]

        # Fenwick tree supporting range XOR updates
        # and point queries.
        bit = [0] * (n + 1)

        def add(i, value):
            while i <= n:
                bit[i] ^= value
                i += i & -i

        def prefix(i):
            result = 0
            while i > 0:
                result ^= bit[i]
                i -= i & -i
            return result

        # Initialize Fenwick tree with root-path masks.
        previous = 0
        for i, u in enumerate(euler):
            difference = root_mask[u] ^ previous
            add(i + 1, difference)
            previous = root_mask[u]

        chars = list(s)
        answer = []

        for query in queries:
            parts = query.split()

            if parts[0] == "update":
                u = int(parts[1])
                new_char = parts[2]

                delta = (
                    (1 << (ord(chars[u]) - ord('a')))
                    ^ (1 << (ord(new_char) - ord('a')))
                )

                if delta:
                    # Every root path through u changes.
                    add(tin[u] + 1, delta)

                    if tout[u] + 1 < n:
                        add(tout[u] + 2, delta)

                chars[u] = new_char

            else:
                u = int(parts[1])
                v = int(parts[2])
                ancestor = lca(u, v)

                mask_u = prefix(tin[u] + 1)
                mask_v = prefix(tin[v] + 1)
                ancestor_bit = 1 << (
                    ord(chars[ancestor]) - ord('a')
                )

                path_mask = mask_u ^ mask_v ^ ancestor_bit

                answer.append(
                    (path_mask & (path_mask - 1)) == 0
                )

        return answer

        

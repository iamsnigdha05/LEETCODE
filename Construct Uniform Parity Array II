class Solution:
    def uniformArray(self, nums1):
        mn = min(nums1)

        # If minimum is odd, we can make all elements odd.
        if mn % 2 == 1:
            return True

        # Minimum is even.
        # To make everything even, all numbers must already be even.
        return all(x % 2 == 0 for x in nums1)
        

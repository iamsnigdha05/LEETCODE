
class Solution:
    def minimumChanges(self, s: str, k: int) -> int:
        n = len(s)

        # Find all proper divisors
        divisors = [[] for _ in range(n + 1)]

        for d in range(1, n):
            for length in range(2 * d, n + 1, d):
                divisors[length].append(d)

        # Calculate the cost for every substring
        cost = [[0] * n for _ in range(n)]

        for i in range(n):
            for j in range(i + 1, n):
                length = j - i + 1
                best = n

                for d in divisors[length]:
                    changes = 0
                    groups = length // d

                    for offset in range(d):
                        left = i + offset
                        right = i + offset + (groups - 1) * d

                        while left < right:
                            if s[left] != s[right]:
                                changes += 1

                            left += d
                            right -= d

                    best = min(best, changes)

                cost[i][j] = best

        # Dynamic programming
        INF = float('inf')
        dp = [[INF] * (k + 1) for _ in range(n + 1)]
        dp[0][0] = 0

        for end in range(1, n + 1):
            for parts in range(1, k + 1):
                for start in range(2 * (parts - 1), end - 1):
                    dp[end][parts] = min(
                        dp[end][parts],
                        dp[start][parts - 1] + cost[start][end - 1]
                    )

        return dp[n][k]

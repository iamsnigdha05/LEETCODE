class Solution:
    def smallestSubsequence(self, s):
        remaining = {}
        for ch in s:
            remaining[ch] = remaining.get(ch, 0) + 1

        stack = []
        in_stack = set()

        for ch in s:
            remaining[ch] -= 1

            if ch in in_stack:
                continue

            while stack and stack[-1] > ch and remaining[stack[-1]] > 0:
                in_stack.remove(stack.pop())

            stack.append(ch)
            in_stack.add(ch)

        return "".join(stack)


class Solution:
    def countServers(self, n, logs, x, queries):
        from collections import defaultdict

        logs.sort(key=lambda log: log[1])

        # Sort queries while keeping their original indices.
        sorted_queries = sorted(
            (q, i) for i, q in enumerate(queries)
        )

        count = defaultdict(int)
        ans = [0] * len(queries)

        left = 0
        right = 0
        active = 0
        total_logs = len(logs)

        for q, idx in sorted_queries:
            start = q - x

            # Add requests within the right boundary.
            while right < total_logs and logs[right][1] <= q:
                server = logs[right][0]
                count[server] += 1

                if count[server] == 1:
                    active += 1

                right += 1

            # Remove requests outside the left boundary.
            while left < right and logs[left][1] < start:
                server = logs[left][0]
                count[server] -= 1

                if count[server] == 0:
                    active -= 1

                left += 1

            ans[idx] = n - active

        return ans

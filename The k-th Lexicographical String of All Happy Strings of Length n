class Solution(object):
    def getHappyString(self, n, k):

        total = 3 * (2 ** (n-1))
        if k > total:
            return ""

        res = []
        prev = ''

        for i in range(n):
            for c in ['a','b','c']:
                if c == prev:
                    continue

                remaining = n - i - 1
                count = 2 ** remaining

                if k > count:
                    k -= count
                else:
                    res.append(c)
                    prev = c
                    break

        return "".join(res)

class Solution:
    def findSubtreeSizes(self, parent, s):
        n = len(parent)

        # Build the original tree
        children = [[] for _ in range(n)]

        for i in range(1, n):
            children[parent[i]].append(i)

        ans = [1] * n
        prev = [-1] * n
        last_seen = {}

        stack = [0]

        while stack:
            node = stack.pop()

            if node >= 0:
                # Find the closest ancestor with the same character
                prev[node] = last_seen.get(s[node], -1)
                last_seen[s[node]] = node

                # Process this node after its children
                stack.append(~node)

                for child in children[node]:
                    stack.append(child)

            else:
                node = ~node

                # Restore the previous ancestor with this character
                last_seen[s[node]] = prev[node]

                # Determine the new parent
                new_parent = prev[node]

                if new_parent == -1:
                    new_parent = parent[node]

                # Add this subtree size to its new parent
                if new_parent != -1:
                    ans[new_parent] += ans[node]

        return ans

        

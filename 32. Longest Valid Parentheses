class Solution:
    def longestValidParentheses(self, s):
        stack = [-1]
        answer = 0

        for i, ch in enumerate(s):
            if ch == '(':
                stack.append(i)
            else:
                stack.pop()

                if not stack:
                    # This ')' cannot be matched
                    stack.append(i)
                else:
                    # Length of current valid substring
                    answer = max(answer, i - stack[-1])

        return answer

class Solution:
    def minDeletionSize(self, strs):
        rows = len(strs)
        cols = len(strs[0])
        delete_count = 0

        for j in range(cols):
            for i in range(1, rows):
                if strs[i][j] < strs[i - 1][j]:
                    delete_count += 1
                    break

        return delete_count

        

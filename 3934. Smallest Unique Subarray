
from typing import List

class Solution:
    def smallestUniqueSubarray(self, nums: List[int]) -> int:
        n = len(nums)

        # Step 1: Build the suffix array using doubling
        sa = list(range(n))
        rank = nums[:]
        k = 1

        while k < n:
            sa.sort(
                key=lambda i: (
                    rank[i],
                    rank[i + k] if i + k < n else -1
                )
            )

            new_rank = [0] * n

            for j in range(1, n):
                a, b = sa[j - 1], sa[j]

                prev = (
                    rank[a],
                    rank[a + k] if a + k < n else -1
                )
                curr = (
                    rank[b],
                    rank[b + k] if b + k < n else -1
                )

                new_rank[b] = new_rank[a] + (prev != curr)

            rank = new_rank

            if rank[sa[-1]] == n - 1:
                break

            k *= 2

        # Step 2: Calculate inverse suffix-array positions
        pos = [0] * n

        for i, start in enumerate(sa):
            pos[start] = i

        # Step 3: Calculate LCP using Kasai's algorithm
        lcp = [0] * n
        h = 0

        for i in range(n):
            r = pos[i]

            if r == 0:
                continue

            j = sa[r - 1]

            while (
                i + h < n
                and j + h < n
                and nums[i + h] == nums[j + h]
            ):
                h += 1

            lcp[r] = h

            if h > 0:
                h -= 1

        # Step 4: Find the shortest unique prefix
        ans = n

        for r in range(n):
            start = sa[r]

            longest_common = lcp[r]

            if r + 1 < n:
                longest_common = max(
                    longest_common,
                    lcp[r + 1]
                )

            length = longest_common + 1

            if length <= n - start:
                ans = min(ans, length)

        return ans

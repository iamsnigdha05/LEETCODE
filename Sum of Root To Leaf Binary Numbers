class Solution:
    def sumRootToLeaf(self, root):
        stack = [(root, 0)]
        total = 0
        
        while stack:
            node, current = stack.pop()
            
            if node:
                current = (current << 1) | node.val
                
                if not node.left and not node.right:
                    total += current
                else:
                    stack.append((node.left, current))
                    stack.append((node.right, current))
        
        return total
        

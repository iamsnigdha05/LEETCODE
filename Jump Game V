class Solution:
    def maxJumps(self, arr, d):
        n = len(arr)
        
        memo = [-1] * n
        
        def dp(i):
            
            if memo[i] != -1:
                return memo[i]
            
            max_steps = 1  
            
            
            for j in range(i + 1, min(i + d + 1, n)):
                if arr[j] >= arr[i]:  
                    break
                max_steps = max(max_steps, 1 + dp(j))
                
             
            for j in range(i - 1, max(i - d - 1, -1), -1):
                if arr[j] >= arr[i]: 
                    break
                max_steps = max(max_steps, 1 + dp(j))
                
            memo[i] = max_steps
            return memo[i]
        
         
        ans = 0
        for i in range(n):
            ans = max(ans, dp(i))
            
        return ans
